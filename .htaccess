# Alte URL nach dem Rename weiterleiten (gecachte Seiten, Lesezeichen, Suchmaschinen)
Redirect 301 /zeichnung.html /gestalttherapie.html

<IfModule mod_headers.c>
  # HTML immer beim Server rückfragen — Safari cached HTML sonst heuristisch
  # und zeigt tagelang alte Seiten mit toten Links.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS/JS sind über ?v=<semver> versioniert: neue Version = neue URL,
  # daher darf die alte URL unbegrenzt im Cache bleiben.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bilder/Fonts ändern sich praktisch nie unter gleichem Namen.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Die Empfaengeradresse des Kontaktformulars wird nur von kontakt.php gelesen.
# Direkter Abruf bleibt gesperrt, damit die Adresse auch dann nicht sichtbar
# wird, wenn der Server einmal kein PHP ausfuehrt.
<Files "mail-to.inc">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
